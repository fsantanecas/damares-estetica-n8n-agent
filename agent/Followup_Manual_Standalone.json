      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        300
      ],
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst toPhone = '+' + item.telefone.replace(/\\D/g,'');\nconst message = 'Olá ' + (item.nome || 'querida') + ' 🌿\\n\\nFaz um tempinho que não nos vemos! Tenho saudades de cuidar do seu bem-estar ✨\\n\\nEstou com agenda aberta e adoraria te receber para uma nova sessão' +\n  (item.ultimo_procedimento ? ' de *' + item.ultimo_procedimento + '*' : '') +\n  '.\\n\\nQuer agendar? É só me chamar por aqui 😊🌿';\nconst body = JSON.stringify({ from: '+5511994265257', to: toPhone, type: 'text', text: { body: message } });\nreturn [{ json: { toPhone, message, body, id: item.id } }];"
      }
    },
    {
      "id": "followup-manual-http",
      "name": "Envia Follow-up Manual HTTP",
