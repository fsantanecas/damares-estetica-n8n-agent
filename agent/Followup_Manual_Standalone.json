            "index": 0
          }
        ]
      ]
    },
    "Monta Mensagem Follow-up Manual": {
      "main": [
        [
          {
            "node": "Envia Follow-up Manual HTTP",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Envia Follow-up Manual HTTP": {
      "main": [
        [
          {
