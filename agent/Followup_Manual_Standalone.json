        "query": "SELECT id, nome, telefone, COALESCE(ultimo_procedimento, '') as ultimo_procedimento\nFROM dm_crm\nWHERE telefone IN ('5511983830603', '5511987191814', '5511996334163', '5511983077945', '5512991276226', '5511991710563')\nORDER BY nome;",
        "options": {}
