        "query": "INSERT INTO dm_crm (nome, telefone, ultimo_atendimento, atualizado_em)\nVALUES\n  ('Mirella Gualandro', '5511983830603', NOW() - INTERVAL '60 days', NOW()),\n  ('Daniele', '5511987191814', NOW() - INTERVAL '60 days', NOW()),\n  ('Danielle Hersz Admoni', '5511996334163', NOW() - INTERVAL '60 days', NOW()),\n  ('Dra Danielle', '5511983077945', NOW() - INTERVAL '60 days', NOW()),\n  ('Marília', '5512991276226', NOW() - INTERVAL '60 days', NOW()),\n  ('Maria Teresa', '5511991710563', NOW() - INTERVAL '60 days', NOW())\nON CONFLICT (telefone) DO NOTHING;",
        "options": {}
      }
    },
